<%- include('partials/headers.ejs') %>

<% if (recommendations.length === 0) { %>
    <p>No recommendations yet — be the first to add one!</p>
    <a href="/submit">Add a Recommendation</a>
<% } else { %>
    <div class="posts-container">
        <% recommendations.forEach(post => { %>
            <div class="post">
                <h3><%= post.title %></h3>
                <img src="<%= post.poster %>" alt="<%= post.title %> poster" class="poster">
                <p><%= post.description %></p>
                <p>Genre: 
                    <% post.genre.split(', ').forEach((g, index, arr) => { %>
                        <span class="<%= g %>"><%= g %></span><% if (index < arr.length - 1) { %>, <% } %>
                    <% }) %>
                </p>
                <p class="votes">Votes: <%= post.votes %></p>
                <form method="post" action="/vote/<%= post.id %>">
                    <button type="submit">Upvote</button>
                </form>
                <form method="post" action="/delete/<%= post.id %>">
                    <button type="submit">Delete</button>
                </form>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include('partials/footer.ejs') %>